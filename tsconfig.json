      "@deepseek-ai/dsh-storage-domain": ["../deepseek-harness/packages/storage/storage-domain/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-storage-json": ["../deepseek-harness/packages/storage/storage-json/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-storage-sqlite": ["../deepseek-harness/packages/storage/storage-sqlite/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-atomic-write": ["../deepseek-harness/packages/util/atomic-write/lib/types/index.d.ts"],
